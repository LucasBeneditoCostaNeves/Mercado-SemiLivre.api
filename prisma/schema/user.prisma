model Profile {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  User      User[]

  @@map("Profiles")
}

model User {
  id        String    @id @default(uuid())
  name      String
  lastName  String
  email     String    @unique
  password  String
  status    Boolean
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  Product   Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
}
