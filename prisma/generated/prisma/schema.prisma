model CartItem {
  id                 String           @id @default(uuid())
  quantity           Int
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productVariationId String
  productVariation   ProductVariation @relation(fields: [productVariationId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now())

  @@unique([userId, productVariationId])
  @@map("CartItems")
}

model Coupon {
  id                String             @id @default(uuid())
  code              String             @unique
  discountType      CouponDiscountType
  discountValue     Decimal
  scope             CouponScope
  createdByRole     CouponCreatorRole
  createdById       String
  sellerId          String?
  productId         String?
  minOrderValue     Decimal?
  maxDiscountValue  Decimal?
  usageLimit        Int?
  usageLimitPerUser Int?
  startsAt          DateTime
  expiresAt         DateTime?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now())

  usages CouponUsage[]

  @@map("Coupons")
}

model CouponUsage {
  id              String   @id @default(uuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String
  discountApplied Decimal
  usedAt          DateTime @default(now())

  @@map("CouponUsages")
}

enum CouponDiscountType {
  percentage
  fixed
}

enum CouponScope {
  global
  seller
  product
}

enum CouponCreatorRole {
  admin
  seller
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("UserFavorites")
}

model UserSearchHistory {
  id         String   @id @default(uuid())
  userId     String
  term       String   @db.VarChar(255)
  searchedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt(sort: Desc)])
  @@map("UserSearchHistory")
}

model UserProductClick {
  id         String   @id @default(uuid())
  userId     String
  productId  String
  sourcePage String   @db.VarChar(100)
  clickedAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clickedAt(sort: Desc)])
  @@map("UserProductClicks")
}

model Order {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId    String      @unique
  status             OrderStatus @default(PENDING)
  shippingCarrier    String
  shippingService    String
  shippingPrice      Decimal
  shippingCep        String?
  shippingState      String?
  shippingCity       String?
  shippingStreet     String?
  shippingNumber     String?
  shippingComplement String?
  totalAmount        Decimal
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now())

  items OrderItem[]

  @@map("Orders")
}

model OrderItem {
  id                 String            @id @default(uuid())
  orderId            String
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariationId String
  title              String
  imageUrl           String
  quantity           Int
  unitPrice          Decimal
  fulfillmentStatus  FulfillmentStatus @default(PENDING)
  inProductionAt     DateTime?
  shippedAt          DateTime?
  receivedAt         DateTime?
  review             ReviewProduct?

  @@map("OrderItems")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum FulfillmentStatus {
  PENDING
  IN_PRODUCTION
  SHIPPED
  RECEIVED
}

model CategoryProducts {
  id        String    @id @default(uuid())
  name      String    @unique
  status    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  Product   Product[]
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  Product   Product[]
}

model Product {
  id                  String             @id @default(uuid())
  title               String
  status              Boolean            @default(true)
  category_product_id String
  categoryProducts    CategoryProducts   @relation(fields: [category_product_id], references: [id], onDelete: Cascade)
  seller_user_id      String
  user                User               @relation(fields: [seller_user_id], references: [id], onDelete: Cascade)
  brand_id            String
  brand               Brand              @relation(fields: [brand_id], references: [id], onDelete: Cascade)
  thumbnail           String
  warrantyInformation String
  aiSummary           String?
  ProductVariation    ProductVariation[]
  UserFavorite        UserFavorite[]
  ProductQuestion     ProductQuestion[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now())
}

model ProductVariation {
  id                     String                   @id @default(uuid())
  title                  String
  discountPercentage     Decimal
  price                  Decimal
  quantity               Int
  description            String
  product_id             String
  product                Product                  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  status                 Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now())
  ReviewProduct          ReviewProduct[]
  productVariationImages productVariationImages[]
  CartItem               CartItem[]
}

model productVariationImages {
  id                   String           @id @default(uuid())
  link                 String
  product_variation_id String
  productVariation     ProductVariation @relation(fields: [product_variation_id], references: [id], onDelete: Cascade)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @default(now())
}

model ReviewProduct {
  id                   String           @id @default(uuid())
  rating               Decimal
  comment              String
  photos               String[]
  country              String?
  product_variation_id String
  productVariation     ProductVariation @relation(fields: [product_variation_id], references: [id], onDelete: Cascade)
  reviewer_id          String
  user                 User             @relation(fields: [reviewer_id], references: [id], onDelete: Cascade)
  order_item_id        String?          @unique
  orderItem            OrderItem?       @relation(fields: [order_item_id], references: [id], onDelete: SetNull)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @default(now())
}

model ProductQuestion {
  id            String    @id @default(uuid())
  product_id    String
  product       Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  buyer_user_id String
  buyer         User      @relation(fields: [buyer_user_id], references: [id], onDelete: Cascade)
  question      String
  answer        String?
  answeredAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Mesmo schema em node_modules para @prisma/client (runtime Nest em dist/ não resolve prisma/generated).
generator client_node_modules {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  User      User[]

  @@map("Profiles")
}

model User {
  id                String              @id @default(uuid())
  name              String
  lastName          String
  email             String              @unique
  password          String
  status            Boolean
  avatarUrl         String?
  profile           Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId         String
  Product           Product[]
  PersonalData      PersonalData?
  Address           Address[]
  ReviewProduct     ReviewProduct[]
  CartItem          CartItem[]
  UserFavorite      UserFavorite[]
  UserSearchHistory UserSearchHistory[]
  UserProductClick  UserProductClick[]
  Order             Order[]
  ProductQuestion   ProductQuestion[]
  CouponUsage       CouponUsage[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now())
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model PersonalData {
  id        String   @id @default(uuid())
  cpf       String   @unique
  birthDate DateTime
  phone     String
  gender    Gender
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model Address {
  id         String   @id @default(uuid())
  cep        String
  state      String
  city       String
  street     String
  number     String
  complement String?
  isDefault  Boolean  @default(false)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}
